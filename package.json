{
  "name": "waterform-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "WaterForm desktop shell",
  "type": "module",
  "scripts": {
    "build:shell": "node scripts/build-shell.mjs",
    "dev": "npm run build:shell && tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check",
    "test:shell": "vitest run",
    "verify": "npm run version:check && npm run build:shell && npm run test:shell && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "esbuild": "^0.25.0",
    "jsdom": "^27.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "engines": {
    "node": ">=22"
  }
}
