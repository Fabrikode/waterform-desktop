{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaterForm",
  "version": "1.0.0",
  "identifier": "com.fabrikode.waterform",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build:shell",
    "beforeBuildCommand": "npm run build:shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'",
      "capabilities": [
        "shell"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Fabrikode",
    "copyright": "© Fabrikode",
    "category": "Business",
    "shortDescription": "WaterForm",
    "longDescription": "WaterForm on the desktop: the same account, the same data, in its own window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5QUZGNjc1RjM4QTg5OEIKUldTTGlZcnpkZmF2cVJjRmxxRmcvU2c4S0kvaEMwd0FXZkRnc1JDRXBRSmJsRW90Y2kvcmY3K3MK",
      "endpoints": [
        "https://waterform.fabrikode.com/api/desktop/latest",
        "https://github.com/Fabrikode/waterform-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
